# ==========================================
# LifeOS 环境变量配置模板
# 复制为 .env 后填入实际值
# ==========================================

# 无真实 API 密钥时先用 Mock 模式开发；接入真实模型后改为 false
LLM_MOCK_MODE=true

# --- LLM 基础配置 ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat

# --- 视觉模型配置 ---
LLM_VISION_MODEL=qwen-vl-max
# 如果视觉模型用不同服务商，单独配置
# LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_VISION_API_KEY=sk-your-vision-key

# --- Embedding 配置 ---
EMBED_MODEL=text-embedding-v2
# 如果 embedding 用不同服务商，单独配置
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=sk-your-embed-key

# --- 数据库配置 ---
DB_PATH=./data/lifeos.db

# --- 向量库配置 ---
CHROMA_PATH=./data/knowledge/chroma

# --- MCP 配置 ---
MCP_MODE=stdio  # stdio | sse
# MCP_SSE_URL=http://localhost:8000/sse

# --- 应用配置 ---
APP_TIMEZONE=Asia/Shanghai
APP_LANGUAGE=zh-CN
